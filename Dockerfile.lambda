FROM public.ecr.aws/lambda/python:3.12
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1
COPY requirements-cloud.txt ${LAMBDA_TASK_ROOT}/
RUN pip install --no-cache-dir --only-binary=:all: -r ${LAMBDA_TASK_ROOT}/requirements-cloud.txt
COPY ticketpilot/ ${LAMBDA_TASK_ROOT}/ticketpilot/
COPY data/knowledge_base.json ${LAMBDA_TASK_ROOT}/data/knowledge_base.json
COPY artifacts/model_numpy.npz artifacts/vectorizer.joblib ${LAMBDA_TASK_ROOT}/artifacts/
CMD ["ticketpilot.lambda_handler.handler"]

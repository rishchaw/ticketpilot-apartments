{
  "uid": "ticketpilot-apartments",
  "title": "TicketPilot Apartment Operations",
  "schemaVersion": 41,
  "version": 1,
  "tags": [
    "ticketpilot",
    "apartments"
  ],
  "timezone": "Asia/Manila",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "description": "Local application counters since process start; not current queue sizes or lifetime totals. No tenant/unit labels. Fleet-wide cloud totals are not collected here.",
  "panels": [
    {
      "id": 1,
      "title": "Concerns received",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "ticketpilot-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 9
      },
      "targets": [
        {
          "expr": "sum(ticketpilot_apartment_events_total{action=\"created\"})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "Manager updates",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "ticketpilot-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 9
      },
      "targets": [
        {
          "expr": "sum(ticketpilot_apartment_events_total{action=\"manager_update\"})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "Tenant replies",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "ticketpilot-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 9
      },
      "targets": [
        {
          "expr": "sum(ticketpilot_apartment_events_total{action=\"tenant_reply\"})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "Apartment API requests / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "ticketpilot-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 8,
        "h": 9
      },
      "targets": [
        {
          "expr": "sum(rate(ticketpilot_http_requests_total{route=~\"/api/apartments.*\"}[15m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "title": "Apartment API p95 latency",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "ticketpilot-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 9,
        "w": 8,
        "h": 9
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(ticketpilot_http_request_duration_seconds_bucket{route=~\"/api/apartments.*\"}[15m])))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "title": "Apartment API server errors / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "ticketpilot-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 9,
        "w": 8,
        "h": 9
      },
      "targets": [
        {
          "expr": "sum(rate(ticketpilot_http_requests_total{route=~\"/api/apartments.*\",status=~\"5..\"}[15m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {}
    }
  ]
}
